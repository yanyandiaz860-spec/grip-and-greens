---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { audience, reasons, competitors, competitiveAdvantage, uniqueAppeal } from '@/data/content';
---
<section id="why" class="section surface-paper grid-paper why" aria-labelledby="why-title">
  <div class="container">
    <SectionHead num="03" label="Who It's For" title="Made for people who train <span class='accent'>with a goal</span>" id="why-title">
      <p class="lead">{uniqueAppeal}</p>
    </SectionHead>

    <div class="why__grid">
      <article class="card audience" data-reveal="left">
        <h3 class="card__kicker">Our audience</h3>
        <p class="audience__age"><span>{audience.ageRange}</span> years old</p>
        <p class="audience__summary">{audience.who}</p>

        <h4 class="audience__sub">Interests</h4>
        <ul class="chips">
          {audience.interests.map((i) => <li>{i}</li>)}
        </ul>

        <h4 class="audience__sub">What they need</h4>
        <ul class="checklist">
          {audience.needs.map((n) => <li><Icon name="check" />{n}</li>)}
        </ul>
      </article>

      <article class="card reasons" data-reveal="right" style="--delay:120ms">
        <h3 class="card__kicker">Why choose Grip &amp; Greens</h3>
        <ol class="reasons__list">
          {reasons.map((r, i) => (
            <li><span class="reasons__num">{String(i + 1).padStart(2, '0')}</span>{r}</li>
          ))}
        </ol>
      </article>
    </div>

    <div class="compete">
      <h3 class="compete__title">Where we fit</h3>
      <ul class="compete__list" data-stagger="90">
        {competitors.map((c) => (
          <li class="compete__item">
            <p class="compete__type">{c.type}</p>
            <p class="compete__note">{c.note}</p>
          </li>
        ))}
        <li class="compete__item compete__item--us">
          <p class="compete__type">Our advantage</p>
          <p class="compete__note">{competitiveAdvantage}</p>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .why__grid {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 960px) { .why__grid { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-6); } }

  .card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--c-white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .card__kicker {
    margin-bottom: var(--space-4);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--c-brown);
  }
  .audience__age {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    font-weight: 700;
    color: var(--t-muted);
  }
  .audience__age span {
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 4vw, 6.5rem);
    font-weight: 400;
    line-height: 0.85;
    color: var(--c-green);
  }
  .audience__summary { margin-top: var(--space-4); max-width: 52ch; }
  .audience__sub {
    margin: var(--space-6) 0 var(--space-3);
    font-size: var(--fs-sm);
    font-weight: 800;
    color: var(--c-ink);
  }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: 600;
    background: var(--c-paper);
  }

  .reasons { background: var(--c-night); border-color: var(--c-night); color: var(--t-on-dark-muted); }
  .reasons .card__kicker { color: var(--c-green-300); }
  .reasons__list { list-style: none; display: grid; }
  .reasons__list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line-dark);
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--t-on-dark);
  }
  .reasons__list li:last-child { border-bottom: 0; }
  .reasons__num { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.12em; color: var(--c-green-300); }

  .compete { margin-top: clamp(3rem, 5vw, 4.5rem); }
  .compete__title {
    margin-bottom: var(--space-5);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--c-brown);
  }
  .compete__list {
    list-style: none;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }
  .compete__item {
    padding: 1.1rem 1.2rem;
    background: rgb(255 255 255 / 0.7);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
  }
  .compete__type { margin-bottom: 0.35rem; font-weight: 800; color: var(--c-ink); }
  .compete__note { font-size: var(--fs-sm); color: var(--t-muted); }
  .compete__item--us { background: var(--c-green); border: 1px solid var(--c-green); }
  .compete__item--us .compete__type,
  .compete__item--us .compete__note { color: #fff; }
</style>
