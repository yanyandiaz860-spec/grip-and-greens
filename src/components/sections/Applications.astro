---
import { Picture, getImage } from 'astro:assets';
import SectionHead from '../SectionHead.astro';
import ArtImage from '../ArtImage.astro';
import { mockupGallery, type MockupFolder } from '@/data/media';

/* The order of a visit: the street, inside, the café counter, then the paperwork */
const route: { folder: MockupFolder; label: string }[] = [
  { folder: 'signage', label: 'Signage' },
  { folder: 'packaging', label: 'Café Packaging' },
  { folder: 'stationery', label: 'Stationery' },
];

const mockups = await Promise.all(
  route.flatMap(({ folder, label }) =>
    mockupGallery(folder).map(async (item) => ({
      ...item,
      label,
      large: await getImage({ src: item.src, format: 'webp', width: Math.min(item.src.width, 1800), quality: 85 }),
    })),
  ),
);

/* Lens ring: same 13-tick scale as the loader dial */
const lensTicks = Array.from({ length: 13 }, (_, i) => -150 + i * 25);
---
<section id="applications" class="section surface-white apps" aria-labelledby="apps-title">
  <div class="container container--wide">
    <SectionHead num="11" label="Brand Applications" title="The brand <span class='accent'>in use</span>" id="apps-title">
      <p class="lead">Where the identity meets real spaces and products: signage, stationery and café packaging.</p>
    </SectionHead>

    <!-- Original branding mockup (promo-04). 480px source, so it stays card-sized. -->
    <div class="feature" data-reveal="scale">
      <ArtImage art="application.mockup-01" group="applications" sizes="480px" />
      <div class="feature__text">
        <p class="feature__kicker">Original branding mockup</p>
        <h3 class="feature__title">Logo wall with training gear</h3>
        <p class="muted">The icon, wordmark and tagline placed on a concrete wall above a training mat.</p>
      </div>
    </div>
  </div>

  <!-- Walkthrough: pinned and full-screen on large screens (html.fx), a swipe row elsewhere -->
  <div class="walk" style={`--steps:${mockups.length}`} data-scene data-scene-opens data-lens-area>
    <div class="walk__stage theme-dark" data-scene-stage>
      <ol class="walk__list" data-swipe aria-label="Brand application mockups">
        {mockups.map((m) => (
          <li class="walk__item" data-step>
            <div class="walk__text">
              <p class="walk__label">{m.label}</p>
              <h3 class="walk__title">{m.title}</h3>
              {m.detail && <p class="walk__detail">{m.detail}</p>}
            </div>
            <a
              class="walk__media"
              style={`--ar:${(m.src.width / m.src.height).toFixed(4)}`}
              href={m.large.src}
              data-lightbox="mockups"
              data-lightbox-title={m.title}
              data-lightbox-detail={m.detail}
              data-lightbox-alt={m.alt}
              data-lightbox-w={m.large.attributes.width}
              data-lightbox-h={m.large.attributes.height}
              aria-label={`${m.title} — view larger`}
            >
              <Picture
                src={m.src}
                alt={m.alt}
                formats={['avif', 'webp']}
                widths={[480, 800, 1200, 1600, 2048]}
                sizes="(min-width: 1024px) 70vw, 86vw"
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))}
      </ol>

      <div class="walk__meter" aria-hidden="true">
        <p class="walk__count"><span data-scene-count>01</span> / {String(mockups.length).padStart(2, '0')}</p>
        <span class="walk__bar"><span></span></span>
        <p class="walk__hint walk__hint--swipe">Swipe to see all {mockups.length}</p>
        <p class="walk__hint walk__hint--lens">Hover to inspect, select to open</p>
      </div>
    </div>
  </div>

  <div class="lens" data-lens aria-hidden="true">
    <div class="lens__glass" data-lens-glass></div>
    <svg class="lens__ring" viewBox="0 0 200 200" focusable="false">
      <circle cx="100" cy="100" r="96" />
      {lensTicks.map((deg, i) => (
        <line x1="100" y1="5" x2="100" y2={i % 3 === 0 ? 19 : 13} transform={`rotate(${deg} 100 100)`} />
      ))}
      <g class="lens__needle"><line x1="100" y1="5" x2="100" y2="27" /></g>
    </svg>
  </div>
</section>

<style>
  .apps { padding-bottom: 0; }

  .feature {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    background: var(--c-paper);
    border-radius: var(--radius-lg);
  }
  @media (min-width: 768px) { .feature { grid-template-columns: minmax(0, 480px) 1fr; } }
  .feature__kicker {
    margin: 0 0 0.4rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--c-green);
  }
  .feature__title {
    margin-bottom: 0.6rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-h3);
    line-height: 1;
  }

  /* ---------- Static layout: one swipe row (phones, tablets, no JS) ---------- */
  .walk { margin-top: clamp(3rem, 5vw, 4.5rem); }
  .walk__stage { padding-block: clamp(2rem, 5vw, 3rem); }
  .walk__list {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .walk__list::-webkit-scrollbar { display: none; }
  .walk__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-4);
    flex: 0 0 min(86vw, 560px);
    scroll-snap-align: start;
  }
  .walk__media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-night-2);
    cursor: zoom-in;
  }
  .walk__media :global(picture) { display: contents; }
  .walk__media :global(img) { display: block; width: 100%; height: auto; }
  .walk__label {
    margin: 0 0 0.35rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--c-green-300);
  }
  .walk__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-h3);
    line-height: 1;
    color: var(--t-on-dark);
  }
  .walk__detail { margin: 0.5rem 0 0; font-size: var(--fs-sm); color: var(--t-on-dark-muted); }

  .walk__meter {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding-inline: var(--gutter);
  }
  .walk__count {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--t-on-dark);
  }
  .walk__bar {
    position: relative;
    flex: 1;
    max-width: 240px;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--line-dark);
  }
  .walk__bar span {
    position: absolute;
    inset: 0;
    background: var(--c-green-300);
    transform-origin: left;
    transform: scaleX(var(--p, 0.1));
    transition: transform 400ms var(--ease-out);
  }
  .walk__hint { margin: 0; font-size: var(--fs-xs); color: var(--t-on-dark-muted); }
  .walk__hint--lens { display: none; }

  /* Large screens without the pinned scene (reduced motion): show everything in a grid */
  @media (min-width: 1024px) {
    :global(html:not(.fx)) .walk__list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6) var(--space-5);
      overflow: visible;
      max-width: calc(var(--container-wide) + var(--gutter) * 2);
      margin-inline: auto;
    }
    :global(html:not(.fx)) .walk__meter { display: none; }
  }

  /* ---------- Pinned walkthrough (html.fx) ---------- */
  :global(html.fx) .walk { height: calc(100svh - var(--header-h) + var(--steps) * 60svh); }
  :global(html.fx) .walk__stage {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    padding: 0;
    overflow: hidden;
    /* Starts as a rounded card inside the white section, then opens to the full screen */
    clip-path: inset(
      calc((1 - var(--open, 1)) * 10%)
      calc((1 - var(--open, 1)) * 14%)
      round calc((1 - var(--open, 1)) * 32px)
    );
  }
  :global(html.fx) .walk__list {
    position: absolute;
    inset: 0;
    display: block;
    padding: 0;
    overflow: visible;
  }
  :global(html.fx) .walk__item {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(270px, 25%) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3.5rem);
    align-items: center;
    padding: clamp(1.25rem, 3.5svh, 2.5rem) var(--gutter);
    pointer-events: none;
    /* opacity, not visibility: hidden steps must stay reachable by keyboard.
       Upcoming steps sit on top so one leaving backwards can wipe away over the active step. */
    opacity: 0;
    z-index: 3;
    /* The step being left stays up during the wipe, then fades. Mockups have different
       shapes, so a wider one would otherwise show around the edges of the next. */
    transition: opacity 250ms linear 500ms, z-index 0s 750ms;
  }
  :global(html.fx) .walk__item.is-past { z-index: 1; }
  :global(html.fx) .walk__item.is-active {
    z-index: 2;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0s, z-index 0s;
  }

  :global(html.fx) .walk__text {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 350ms var(--ease-out), transform 350ms var(--ease-out);
    margin-bottom: 5.5rem;
  }
  :global(html.fx) .walk__item.is-active .walk__text {
    /* Waits until the opening window is wide enough not to cut the words */
    opacity: clamp(0, calc((var(--open, 1) - 0.8) * 5), 1);
    transform: none;
    transition: opacity 650ms var(--ease-out) 180ms, transform 800ms var(--ease-out) 180ms;
  }
  :global(html.fx) .walk__title { font-size: clamp(2.6rem, 1.4rem + 3vw, 4.75rem); }
  :global(html.fx) .walk__detail { margin-top: var(--space-4); font-size: var(--fs-base); line-height: 1.55; }

  :global(html.fx) .walk__media {
    display: grid;
    place-items: center;
    height: 100%;
    min-height: 0;
    overflow: visible;
    background: none;
    container-type: size;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 750ms cubic-bezier(0.76, 0, 0.24, 1);
  }
  :global(html.fx) .walk__item.is-active .walk__media,
  :global(html.fx) .walk__item.is-past .walk__media { clip-path: inset(-5% -5% -5% -5%); }
  :global(html.fx) .walk__media :global(img) {
    /* Sized from the known ratio, so the box is right before the file arrives */
    width: min(100cqw, calc(100cqh * var(--ar)));
    height: auto;
    aspect-ratio: var(--ar);
    border-radius: var(--radius);
    background: var(--c-night-2);
    transform: scale(calc(1 + var(--lp, 0) * 0.035));
  }
  :global(html.fx) .walk.is-lens .walk__media { cursor: none; }

  :global(html.fx) .walk__meter {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(1.25rem, 3.5svh, 2.5rem);
    z-index: 4;
    opacity: clamp(0, calc((var(--open, 1) - 0.8) * 5), 1);
    flex-wrap: wrap;
    width: calc(max(270px, 25%) - var(--gutter));
    gap: 0.5rem var(--space-4);
    margin: 0;
    padding: 0;
  }
  :global(html.fx) .walk__hint { flex-basis: 100%; }
  :global(html.fx) .walk__hint--swipe { display: none; }
  @media (hover: hover) and (pointer: fine) {
    :global(html.fx) .walk__hint--lens { display: block; }
  }

  /* ---------- Dial lens ---------- */
  .lens {
    --size: clamp(190px, 17vw, 260px);
    position: fixed;
    left: 0;
    top: 0;
    z-index: 90;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    pointer-events: none;
    opacity: 0;
    scale: 0.6;
    transition: opacity 180ms var(--ease), scale 240ms var(--ease-out);
  }
  .lens.is-on { opacity: 1; scale: 1; }
  .lens__glass {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-color: var(--c-night-2);
    background-repeat: no-repeat;
    box-shadow: 0 18px 44px -12px rgb(0 0 0 / 0.7);
  }
  .lens__ring { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .lens__ring circle { fill: none; stroke: var(--c-green-300); stroke-width: 3; }
  .lens__ring line { stroke: #fff; stroke-width: 2; stroke-linecap: round; filter: drop-shadow(0 0 2px rgb(0 0 0 / 0.7)); }
  .lens__needle { transform-origin: 100px 100px; transform: rotate(var(--needle, 0deg)); }
  .lens__needle line { stroke: var(--c-green-300); stroke-width: 4; }
  @media (hover: none) { .lens { display: none; } }
</style>
