---
import { Picture } from 'astro:assets';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { owners, instagramUrl } from '@/data/owners';
import { art } from '@/data/media';
---
<section id="owners" class="section surface-paper grid-paper owners" aria-labelledby="owners-title">
  <div class="container container--wide">
    <SectionHead num="07" label="The Owners" title="The people behind <span class='accent'>Grip &amp; Greens</span>" id="owners-title">
      <p class="lead">Four co-owners who developed the Grip &amp; Greens concept together.</p>
    </SectionHead>

    <ul class="owners__list" data-stagger="120">
      {owners.map((o) => {
        const photo = art[o.photo];
        return (
          <li class="owner">
            <div class="owner__frame marks">
              <div class="owner__photo" style={`--focus:${o.focus};--zoom:${o.zoom ?? 1}`}>
                <Picture
                  src={photo.src}
                  alt={photo.alt}
                  formats={['avif', 'webp']}
                  widths={[320, 480, 640, 800]}
                  sizes="(min-width: 1180px) 280px, (min-width: 640px) 45vw, 90vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="owner__body">
              <p class="owner__role">{o.role}</p>
              <h3 class="owner__name">{o.name}</h3>
              <a class="owner__ig" href={instagramUrl(o.instagram)} target="_blank" rel="noopener noreferrer">
                <Icon name="instagram" size={18} />
                <span>@{o.instagram}</span>
                <Icon name="arrow-up-right" size={14} class="owner__ext" />
                <span class="sr-only">— {o.name} on Instagram (opens in a new tab)</span>
              </a>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .owners__list {
    list-style: none;
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 2rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  @media (min-width: 1180px) { .owners__list { grid-template-columns: repeat(4, 1fr); } }

  .owner__frame {
    padding: 10px;
    background: var(--c-white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .owner__photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
    background: var(--c-paper-2);
  }
  .owner__photo :global(picture) { display: block; height: 100%; }
  .owner__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
    transform: scale(var(--zoom));
    transform-origin: var(--focus);
    transition: transform 700ms var(--ease);
  }
  .owner:hover .owner__photo :global(img) { transform: scale(calc(var(--zoom) * 1.03)); }

  .owner__body { padding: var(--space-4) 0.25rem 0; }
  .owner__role {
    margin-bottom: 0.3rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--c-green);
  }
  .owner__name {
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.3;
  }
  .owner__ig {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    margin-top: 0.2rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--t-body);
    text-decoration: none;
    word-break: break-all;
  }
  .owner__ig:hover span:first-of-type { text-decoration: underline; text-decoration-color: var(--c-green); text-underline-offset: 3px; }
  .owner__ig :global(.icon) { flex: none; color: var(--c-green); }
</style>
