---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { story } from '@/data/content';
const { gap } = story;
---
<section id="story" class="section surface-white" aria-labelledby="story-title">
  <div class="container story__grid">
    <div class="story__text">
      <SectionHead num="01" label="Our Story" title="Born from a gap we kept seeing" id="story-title">
        <p class="lead">{story.lead}</p>
      </SectionHead>
      <div class="story__body" data-reveal>
        {story.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <div class="gap" data-stagger="110" aria-label="The gap Grip & Greens fills" role="group">
      <div class="gap__card">
        <p class="gap__title">{gap.gym.title}</p>
        <p class="gap__row gap__row--yes"><Icon name="check" size={18} /> {gap.gym.has}</p>
        <p class="gap__row gap__row--no"><Icon name="x" size={18} /> {gap.gym.lacks}</p>
      </div>
      <div class="gap__card">
        <p class="gap__title">{gap.cafe.title}</p>
        <p class="gap__row gap__row--yes"><Icon name="check" size={18} /> {gap.cafe.has}</p>
        <p class="gap__row gap__row--no"><Icon name="x" size={18} /> {gap.cafe.lacks}</p>
      </div>
      <div class="gap__join" aria-hidden="true"><span>so we combined them</span></div>
      <div class="gap__card gap__card--us">
        <p class="gap__title">{gap.us.title}</p>
        <p class="gap__row gap__row--yes"><Icon name="check" size={18} /> Training &amp; equipment</p>
        <p class="gap__row gap__row--yes"><Icon name="check" size={18} /> Goal-based meals &amp; drinks</p>
        <p class="gap__row gap__row--yes"><Icon name="check" size={18} /> One roof, one membership</p>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="timeline">
      <h3 class="timeline__title" data-reveal="fade">How the idea took shape</h3>
      <ol class="timeline__list" data-stagger="120">
        {story.milestones.map((m, i) => (
          <li class:list={['timeline__item', { 'timeline__item--us': i === story.milestones.length - 1 }]}>
            <span class="timeline__year">{m.year}</span>
            <span class="timeline__track" aria-hidden="true"><span class="timeline__dot" /></span>
            <p class="timeline__text">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .story__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }
  @media (min-width: 1024px) { .story__grid { grid-template-columns: 1.15fr 0.85fr; } }
  .story__text :global(.section-head) { margin-bottom: var(--space-6); }
  .story__body { max-width: 60ch; }

  /* Gap diagram */
  .gap {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--c-paper);
    border-radius: var(--radius-lg);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  @media (min-width: 1024px) { .gap { margin-top: 3.5rem; } }
  .gap__card {
    padding: 1.1rem 1.25rem;
    background: var(--c-white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .gap__title {
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--c-ink);
  }
  .gap__row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0.3rem 0 0;
    font-size: var(--fs-sm);
  }
  .gap__row--yes :global(svg) { color: var(--c-green); flex: none; }
  .gap__row--no { color: var(--t-muted); }
  .gap__row--no :global(svg) { color: #a3442e; flex: none; }
  .gap__join {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-brown);
  }
  .gap__join::before,
  .gap__join::after { content: ''; flex: 1; height: 2px; background: var(--c-green); }
  .gap__card--us {
    background: var(--c-green);
    border-color: var(--c-green);
    color: #fff;
  }
  .gap__card--us .gap__title { color: #fff; }
  .gap__card--us .gap__row--yes :global(svg) { color: #fff; }

  /* Timeline
     Each item: [year] / [track] / [text]. The track row draws its own segment of the
     line at top:50% and centres the dot with flexbox, so line and dots always share
     one axis, at every width. Phones switch to a vertical line through the dots. */
  .timeline {
    --dot: 16px;
    --tl-gap: clamp(1rem, 2.5vw, 1.75rem);
    margin-top: clamp(3.5rem, 6vw, 5.5rem);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .timeline__title {
    margin-bottom: var(--space-6);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--c-brown);
  }
  .timeline__list { list-style: none; display: grid; }
  .timeline__item { position: relative; display: grid; }
  .timeline__year {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--c-ink);
  }
  .timeline__track {
    position: relative;
    display: flex;
    align-items: center;
    height: calc(var(--dot) + 10px);
  }
  .timeline__track::before {
    content: '';
    position: absolute;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    left: 0;
    right: calc(var(--tl-gap) * -1);
    background: repeating-linear-gradient(90deg, var(--line-strong) 0 6px, transparent 6px 12px);
  }
  .timeline__item:last-child .timeline__track::before { right: 0; }
  .timeline__dot {
    position: relative;
    z-index: 1;
    flex: none;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--c-white);
    border: 2px solid var(--c-ink);
    transition: transform 300ms var(--ease);
  }
  .timeline__item:hover .timeline__dot { transform: scale(1.2); }
  .timeline__item--us .timeline__year { color: var(--c-green); }
  .timeline__item--us .timeline__dot {
    background: var(--c-green);
    border-color: var(--c-green);
    box-shadow: 0 0 0 5px var(--c-green-50);
  }
  .timeline__text { margin: 0; font-size: var(--fs-sm); max-width: 28ch; }

  /* Horizontal (tablet / desktop) */
  @media (min-width: 768px) {
    .timeline__list { grid-template-columns: repeat(4, 1fr); column-gap: var(--tl-gap); }
    .timeline__item { grid-template-rows: auto auto 1fr; row-gap: 0.75rem; }
  }

  /* Vertical (phones): line runs down through the dots */
  @media (max-width: 767px) {
    .timeline__item {
      grid-template-columns: 4.25rem calc(var(--dot) + 10px) 1fr;
      column-gap: 0.9rem;
      align-items: start;
      padding-bottom: 1.5rem;
    }
    .timeline__item:last-child { padding-bottom: 0; }
    .timeline__year { font-size: 2rem; }
    .timeline__track {
      height: auto;
      align-self: stretch;
      flex-direction: column;
      justify-content: flex-start;
      padding-top: 0.55rem;
      margin-bottom: -1.5rem;
    }
    .timeline__item:last-child .timeline__track { margin-bottom: 0; }
    .timeline__track::before {
      top: 0.55rem;
      bottom: 0;
      left: 50%;
      right: auto;
      width: 2px;
      height: auto;
      margin: 0 0 0 -1px;
      background: repeating-linear-gradient(180deg, var(--line-strong) 0 6px, transparent 6px 12px);
    }
    .timeline__item:last-child .timeline__track::before { display: none; }
    .timeline__text { padding-top: 0.35rem; }
  }
</style>
