---
/**
 * ScrollDial — the loader's scale dial, kept in the header as a page-progress meter.
 * The needle and arc follow `--scroll` (0–1), set in scripts/scrollfx.ts. Decorative.
 */
const C = 20, R = 15;
const pt = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return { x: +(C + r * Math.sin(a)).toFixed(2), y: +(C - r * Math.cos(a)).toFixed(2) };
};
const a0 = pt(-150, R), a1 = pt(150, R);
const arc = `M${a0.x} ${a0.y} A${R} ${R} 0 1 1 ${a1.x} ${a1.y}`;
---
<span class="dial" data-scroll-dial aria-hidden="true">
  <svg viewBox="0 0 40 40" focusable="false">
    <path class="dial__track" d={arc} pathLength="100" />
    <path class="dial__arc" d={arc} pathLength="100" />
    <line class="dial__needle" x1="20" y1="20" x2="20" y2="9" />
    <circle class="dial__hub" cx="20" cy="20" r="2.6" />
  </svg>
</span>

<style>
  .dial { display: none; }
  :global(html.js) .dial {
    display: block;
    flex: none;
    width: 40px;
    height: 40px;
    margin-left: auto;
    margin-right: calc(var(--space-5) * -0.4);
  }
  .dial svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .dial__track,
  .dial__arc { fill: none; stroke-width: 3; stroke-linecap: round; }
  .dial__track { stroke: var(--line-strong); }
  .dial__arc {
    stroke: var(--c-green);
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - 100 * var(--scroll, 0));
  }
  .dial__needle {
    stroke: var(--c-ink);
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: 20px 20px;
    transform: rotate(calc(-150deg + 300deg * var(--scroll, 0)));
  }
  .dial__hub { fill: var(--c-green); }
</style>
