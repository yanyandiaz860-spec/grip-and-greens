---
import Icon, { type IconName } from './Icon.astro';
interface Props {
  items: readonly { name: string; icon: string }[];
  label: string;
}
const { items, label } = Astro.props;
---
<ul class="services" aria-label={label} data-stagger="45">
  {items.map((s, i) => (
    <li class="services__item">
      <span class="services__icon"><Icon name={s.icon as IconName} size={22} /></span>
      <span class="services__name">{s.name}</span>
      <span class="services__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
    </li>
  ))}
</ul>

<style>
  .services {
    --svc-accent: var(--c-green);
    --svc-on-accent: var(--c-white);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    border-top: 1px solid var(--line);
  }
  :global(.theme-dark) .services {
    --svc-accent: var(--c-green-300);
    --svc-on-accent: var(--c-night);
  }
  .services__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .services__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--c-green);
    flex: none;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  :global(.theme-dark) .services__icon { color: var(--c-green-300); background: rgb(255 255 255 / 0.03); }
  .services__name {
    font-weight: 700;
    color: var(--t-strong);
    line-height: 1.3;
    transition: translate var(--dur) var(--ease);
  }
  .services__num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--t-muted);
    opacity: 0.7;
    transition: color var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  /* Hover: the row's own transition belongs to the scroll reveal (box-shadow is included there) */
  @media (hover: hover) {
    .services__item:hover { box-shadow: inset 0 -2px 0 var(--svc-accent); }
    .services__item:hover .services__icon {
      background: var(--svc-accent);
      border-color: var(--svc-accent);
      color: var(--svc-on-accent);
    }
    .services__item:hover .services__name { translate: 4px 0; }
    .services__item:hover .services__num { color: var(--svc-accent); opacity: 1; }
  }
</style>
