---
import Icon from './Icon.astro';
---
<dialog class="lb" data-lightbox-dialog aria-labelledby="lb-title">
  <div class="lb__bar">
    <p class="lb__title" id="lb-title" data-lb-title></p>
    <p class="lb__count" data-lb-count aria-live="polite"></p>
    <button class="lb__btn" type="button" data-lb-close aria-label="Close image viewer">
      <Icon name="x" size={22} />
    </button>
  </div>
  <div class="lb__stage" data-lb-stage>
    <button class="lb__btn lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Previous image">
      <Icon name="chevron-left" size={26} />
    </button>
    <img class="lb__img" data-lb-img alt="" decoding="async" />
    <button class="lb__btn lb__nav lb__nav--next" type="button" data-lb-next aria-label="Next image">
      <Icon name="chevron-right" size={26} />
    </button>
  </div>
  <p class="lb__detail" data-lb-detail hidden></p>
  <p class="lb__hint">Original artwork · Esc to close{' '}<span class="lb__hint-keys">· ← → to browse</span></p>
</dialog>

<style>
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(12 14 15 / 0.96);
    color: #fff;
    display: none;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
  }
  .lb[open] { display: grid; animation: lb-in 200ms var(--ease); }
  .lb::backdrop { background: rgb(0 0 0 / 0.6); }
  .lb__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem clamp(0.75rem, 3vw, 1.5rem);
  }
  .lb__title { margin: 0; flex: 1; font-weight: 700; font-size: var(--fs-sm); }
  .lb__count { margin: 0; font-size: var(--fs-xs); letter-spacing: 0.1em; color: #c9cdcf; }
  .lb__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 0 clamp(0.5rem, 6vw, 5rem);
  }
  .lb__img {
    max-width: 92vw;
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.7);
    opacity: 0;
    transition: opacity 200ms var(--ease);
    touch-action: pan-y;
  }
  .lb.has-detail .lb__img { max-height: calc(100dvh - 12rem); }
  .lb__img.is-loaded { opacity: 1; }
  .lb__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    transition: background var(--dur) var(--ease);
  }
  .lb__btn:hover { background: rgb(255 255 255 / 0.18); }
  .lb__btn:focus-visible { box-shadow: 0 0 0 3px #0c0e0f, 0 0 0 5px var(--c-green-300); }
  .lb__btn[hidden] { display: none; }
  .lb__nav { position: absolute; top: 50%; translate: 0 -50%; z-index: 1; }
  .lb__nav--prev { left: clamp(0.5rem, 2vw, 1.5rem); }
  .lb__nav--next { right: clamp(0.5rem, 2vw, 1.5rem); }
  .lb__detail {
    justify-self: center;
    max-width: 62ch;
    margin: 0;
    padding: 0.85rem 1.25rem 0;
    text-align: center;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: #e6e8e9;
  }
  .lb__detail[hidden] { display: none; }
  .lb__hint { margin: 0; padding: 0.75rem; text-align: center; font-size: 0.75rem; color: #aeb3b6; }
  @media (hover: none) { .lb__hint-keys { display: none; } }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
</style>
